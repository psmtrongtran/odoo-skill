{
  "odoo_versions": {
    "14.0": {
      "python_version": "3.8",
      "postgresql_version": "12",
      "supported": true,
      "lts": false,
      "eol_date": "2029-04-01"
    },
    "15.0": {
      "python_version": "3.9",
      "postgresql_version": "13",
      "supported": true,
      "lts": false,
      "eol_date": "2029-11-01"
    },
    "16.0": {
      "python_version": "3.10",
      "postgresql_version": "14",
      "supported": true,
      "lts": false,
      "eol_date": "2030-11-01"
    },
    "17.0": {
      "python_version": "3.10",
      "postgresql_version": "14",
      "supported": true,
      "lts": true,
      "eol_date": "2034-05-01"
    },
    "18.0": {
      "python_version": "3.10",
      "postgresql_version": "12",
      "supported": true,
      "lts": false,
      "eol_date": "2035-11-01"
    },
    "19.0": {
      "python_version": "3.10",
      "postgresql_version": "13",
      "supported": true,
      "lts": true,
      "eol_date": "2036-05-01",
      "features": {
        "owl_version": "2.0",
        "web_framework": "OWL 2.0",
        "orm_changes": [
          "models.Constraint / models.Index as model attributes (since 18.1), superseding _sql_constraints",
          "read_group deprecated in favor of _read_group (internal) and formatted_read_group (public API) (since 18.2)",
          "json controller type renamed to jsonrpc (since 18.1)",
          "odoo.osv deprecated; record._cr/_context/_uid deprecated in favor of self.env.cr/context/uid (19.0)",
          "Demo data no longer loaded by default (since 18.3)"
        ]
      }
    },
    "20.0": {
      "python_version": "3.12",
      "postgresql_version": "16",
      "supported": true,
      "lts": false,
      "eol_date": null,
      "features": {
        "owl_version": "2.0",
        "web_framework": "OWL 2.0",
        "orm_changes": [
          "Mail tracking values removed; tracking message generated on the fly (burndown charts, stage duration updated via new framework)"
        ],
        "platform_changes": [
          "Minimum Python raised from 3.10 to 3.12",
          "Minimum PostgreSQL raised from 13 to 16",
          "pgvector extension required for Odoo AI features (PostgreSQL 15+)",
          "Font Awesome icons replaced by Material Symbols",
          "Push notifications moved from Firebase to in-house Odoo push tools"
        ],
        "ai_features": [
          "Agentic automation: automate processes in plain language, agents update themselves",
          "Agents summoned by automated/scheduled actions; automation chats show handling + error feedback",
          "AI agents create/update records, generate images, filter by time period, ask file questions",
          "MCP (Model Context Protocol) database connection for external AI tools with access rights intact",
          "AI features require IAP credits; automatic AI model selection; default prompts with context",
          "Website: AI page/snippet generation, AI SEO improvements, structured data by default"
        ]
      }
    }
  },
  "default_version": "20.0",
  "development_settings": {
    "auto_reload": true,
    "dev_mode": true,
    "log_level": "debug",
    "test_enabled": true,
    "without_demo": false
  },
  "environments": {
    "local": {
      "type": "local",
      "command": "odoo",
      "config_file": "odoo.conf",
      "addons_path": "./addons",
      "database_host": "localhost"
    },
    "docker": {
      "type": "docker",
      "image": "odoo:20.0",
      "compose_file": "docker-compose.yml",
      "ports": {
        "odoo": "8069:8069",
        "postgres": "5432:5432"
      }
    },
    "odoo_sh": {
      "type": "odoo.sh",
      "platform_url": "https://odoo.sh",
      "deployment": "git push",
      "branches": ["main", "production", "staging"]
    }
  },
  "module_standards": {
    "naming_convention": "lowercase_with_underscores",
    "license": "LGPL-3",
    "author": "Your Company",
    "website": "https://www.yourcompany.com",
    "depends": ["base"],
    "data_files": [
      "security/security_rules.xml",
      "security/ir.model.access.csv",
      "views/main_model_views.xml",
      "views/menus.xml"
    ],
    "assets": {
      "web.assets_frontend": [
        "module_name/static/src/components/**/*.js",
        "module_name/static/src/**/*.scss"
      ],
      "web.assets_backend": [
        "module_name/static/src/xml/**/*.xml"
      ]
    }
  },
  "python_standards": {
    "version": "3.12+",
    "style_guide": "PEP 8",
    "max_line_length": 100,
    "import_order": [
      "odoo",
      "odoo.addons",
      "third_party",
      "local"
    ]
  },
  "postgresql_standards": {
    "version": "16+",
    "extensions": ["unaccent", "pg_trgm"],
    "optimizations": {
      "indexes": true,
      "constraints": true,
      "foreign_keys": true
    }
  },
  "testing_framework": {
    "framework": "pytest-odoo",
    "coverage_target": 80,
    "test_types": [
      "unit",
      "integration",
      "ui_tours"
    ]
  }
}
